# API keys for ai-playground
# Copy this file to .env and fill in your keys. Leave a line empty to skip that provider.
# A text script uses the first key that is set, in the order below.

# DeepSeek: text and reasoning, the first choice
DEEPSEEK_API_KEY=

# Google AI Studio: vision and embeddings, and the second choice for text
GEMINI_API_KEY=

# OpenAI: the fallback when neither key above is set
OPENAI_API_KEY=
# Optional. Sends OPENAI_API_KEY to another OpenAI-compatible endpoint instead.
# The DeepSeek and Gemini keys above never use it.
# OPENAI_BASE_URL=https://api.openai.com/v1
# Optional. The chat model to ask for with OPENAI_API_KEY, gpt-4o-mini by default.
# OPENAI_MODEL=gpt-4o-mini

# Web search for 02-08 (free tier: 1,000 credits a month). Leave empty to skip that part.
TAVILY_API_KEY=
