# API Key Configuration for ai-playground
# Copy this file to .env and fill in your keys.

# Option 1: DeepSeek Native API (Recommended for Text / Reasoning)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
OPENAI_BASE_URL=https://api.deepseek.com

# Option 2: Google AI Studio API (Recommended for Free Multimodal Vision & Long Context)
GEMINI_API_KEY=AIzaSy-your-gemini-api-key
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Option 3: Alibaba DashScope API (Qwen / DeepSeek Proxy / Qwen-VL)
DASHSCOPE_API_KEY=sk-your-dashscope-api-key
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Option 4: OpenAI Official API
OPENAI_API_KEY=sk-your-openai-api-key
