# API Key Configuration for ai-playground
# Copy this file to .env and fill in your keys. Leave a line empty to skip that provider.

# Option 1: DeepSeek Native API (Recommended for Text / Reasoning)
DEEPSEEK_API_KEY=

# Option 2: Google AI Studio API (Recommended for Free Multimodal Vision & Long Context)
GEMINI_API_KEY=

# Option 3: OpenAI Official API
OPENAI_API_KEY=
# Optional. Sends OPENAI_API_KEY to another OpenAI-compatible endpoint instead.
# The DeepSeek and Gemini keys above never use it.
# OPENAI_BASE_URL=https://api.openai.com/v1
