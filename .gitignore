# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# --- Virtual environments ---
venv/
.venv/
# e.g. .venv-graphrag, the isolated interpreter script 13 drives
.venv-*/
env/
ENV/

# --- Secrets & local config ---
.env
.env.*
!.env.example

# --- Vector index / binary artifacts (regenerated by running the scripts) ---
*.faiss
*.pkl
*.index

# --- Model weights (downloaded on demand, never committed) ---
weights/
models/
*.safetensors
*.gguf
*.bin

# --- Data ---
# Source files under data/ ARE committed: the scripts have no download URL for
# them and they are small. Only bulk formats and files derived at runtime are
# ignored here.
*.parquet
*.xlsx
*.db
*.sqlite
*.segmented.txt
*.partial

# --- Large media / source material ---
*.pdf
*.zip
# Exception: source documents the scripts read. They have no download URL and
# the scripts cannot run without them.
!02-rag/data/*.pdf
!02-rag/data/disney_kb/**

# --- Editor / OS ---
.vscode/
.idea/
.DS_Store
.specstory/
.cursorindexingignore

# Runtime artefacts rebuilt by 03-text2sql/01_build_insurance_db.py and the
# scripts that follow it. Nothing here is source.
03-text2sql/data/schema.sql
03-text2sql/data/vanna_store/
03-text2sql/data/charts/

# Runtime artefacts rebuilt by the 05-fine-tuning scripts: rendered images,
# trained adapters and the generated training split. Nothing here is source.
05-fine-tuning/outputs/
05-fine-tuning/data/underwriting_triage.jsonl

# Runtime artefacts rebuilt by the 06-multimodal-vision scripts: rendered forms,
# the synthesised clip, the generated detection dataset and its training run.
# Every script regenerates its own inputs, so nothing here is source.
06-multimodal-vision/outputs/

# Detector weights the trainer fetches on its own: the automatic mixed-precision
# check downloads a small checkpoint into the working directory before training.
*.pt

# Runtime artefacts rebuilt by 07-ml-dl-foundation/01_build_tabular_datasets.py
# and by the plots script 07 writes. The generator is seeded and reproduces the
# five tables byte for byte, so none of this is source.
07-ml-dl-foundation/data/
07-ml-dl-foundation/outputs/

# CatBoost writes a training log directory into the working directory on every
# fit. It reappears whenever a script that uses CatBoost runs.
catboost_info/

# Runtime artefacts rebuilt by 08-time-series/01_build_time_series_datasets.py
# and written by the backtest script. The generator is seeded and reproduces the
# five series byte for byte, so none of this is source.
08-time-series/data/
08-time-series/outputs/

# Written by 09-lowcode-platforms scripts at run time, rewritten identically on every run
09-lowcode-platforms/data/review_feed/
09-lowcode-platforms/data/mock_platform_server.py

# Runtime artefacts rebuilt by 10-projects/01_build_project_datasets.py and written
# by the scripts that follow it. The generator is seeded and reproduces every file
# byte for byte, so none of this is source.
10-projects/data/
10-projects/outputs/
